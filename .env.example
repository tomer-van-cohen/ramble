# --- site ---
PORT=4599
# 127.0.0.1 = this machine only; 0.0.0.0 to serve the public link (cloud).
HOST=127.0.0.1
# Protects /admin (health only). Without it /admin is disabled. 10 wrong
# attempts lock an address out for 15 minutes.
ADMIN_PASSWORD=
# Optional: a username too (long and random, like the password). Unset = any username.
# ADMIN_USER=
# Optional: require an invite code on the landing page (closed beta).
# INVITE_CODE=
# Proxy hops in front of the app, so rate limits see real client addresses: 0 when exposed
# directly, 1 for most PaaS, 2 on Railway (its edge adds a hop). Too low and every visitor
# shares the proxy's address, and one limit. To check: fail an /admin sign-in once and read
# the address in the "admin sign-in failed from" log line; it must be yours, not the proxy's.
TRUST_PROXY=1
# Sign-ups per address per hour, and how many accounts may wait unscanned at once.
# STARTS_PER_HOUR=5
# MAX_PENDING=10
# Where linked accounts live (DATA_DIR/tenants/<id>/). In the cloud point this at
# a persistent volume (e.g. /data) — attach it BEFORE anyone links.
# DATA_DIR=/data
# Name of the control group created in each user's WhatsApp, and of the product.
PRODUCT_NAME=Ramble
# The site's one home. Requests that arrive on a retired domain (LEGACY_HOSTS,
# comma-separated) are redirected to it, path included. Leave both unset to serve
# whatever host the request came in on.
# CANONICAL_HOST=ramble.baby
# LEGACY_HOSTS=readable.live,www.readable.live
# The site's address for links sent into WhatsApp (the "settings" command). Defaults to
# https://CANONICAL_HOST, or the domain Railway gives the service.
# PUBLIC_URL=https://ramble.example
# The landing page shows the repo's GitHub star count (REPO_URL), fetched hourly. Turn it off with:
# GITHUB_STARS=off
# Capacity and per-account daily audio cap (minutes; 0 = unlimited).
MAX_TENANTS=50

# --- cost controls (read these before opening the door to users) ---
# Transcription is the cost. Three ceilings, all reserved before a provider is ever called:
DAILY_MINUTES_CAP=30        # minutes of audio per account per UTC day (0 = unlimited)
GLOBAL_DAILY_MINUTES=600    # minutes of audio for the WHOLE server per day (0 = unlimited)
MAX_TRANSCRIBE_SECONDS=600  # a single recording longer than this is skipped (a forwarded lecture)
# The same recording sent twice (typically forwarded into the control group) is
# served from memory and costs nothing; this is how long that is remembered:
# DEDUPE_TTL_MINUTES=60
# Also set a hard spending limit with your model provider. The caps above bound
# the audio; only the provider can bound the money.

# --- keeping recordings to improve the product (opt-in, per account) ---
# Off for every account unless its owner opts in (admin: POST /admin/keep-audio/<id>?on=1).
# A kept recording is stored under DATA_DIR/research/<account>/ with a sidecar
# holding what the models made of it, then pruned by age and total size.
# RESEARCH_KEEP_DAYS=30
# RESEARCH_MAX_MB=500

# --- the hosts data may go to (src/providers.js) ---
# These are the ONLY addresses audio or text ever leaves this process for, and the only
# place keys are read. Each is any OpenAI-compatible endpoint; a host without a key is off.
# Which model is asked where is the brain's; the plain brain in this repository asks the
# account's plan host once, for TRANSCRIBE_MODEL / FREE_TRANSCRIBE_MODEL.
# Two plans, chosen per account (admin: POST /admin/plan/<id>?plan=free|pro):
#   pro  → TRANSCRIBE_*        free → FREE_TRANSCRIBE_*
DEFAULT_PLAN=pro
# Speech-to-text (/audio/transcriptions).
TRANSCRIBE_API_KEY=
TRANSCRIBE_BASE_URL=
TRANSCRIBE_MODEL=
FREE_TRANSCRIBE_API_KEY=
FREE_TRANSCRIBE_BASE_URL=
FREE_TRANSCRIBE_MODEL=
# One more speech host, used only by a brain that asks for it.
# DEEPINFRA_API_KEY=
# DEEPINFRA_BASE_URL=
# Cloudflare Workers AI, likewise; needs both (a token from the Workers AI page, read + edit).
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# A chat host for text jobs (/chat/completions), and one for when it is down; used only
# by a brain that has text jobs. Each key defaults to a transcriber key for the same host.
# SUMMARY_BASE_URL=
# SUMMARY_API_KEY=
# LLM_FALLBACK_BASE_URL=
# LLM_FALLBACK_API_KEY=
# --- the brain ---
# The private brain is loaded from ./brain (or BRAIN_DIR) when it is there; otherwise the
# plain brain in src/brain/ runs. REQUIRE_BRAIN=1 refuses to start without the private one.
# BRAIN_DIR=
# REQUIRE_BRAIN=0
# The minimum recording length that is transcribed at all (accidental mic taps).
# TRANSCRIBE_MIN_SECONDS=1
# Videos: off by default; an admin turns them on per account (admin page → Support tools).
# TRANSCRIBE_VIDEO=1 turns them on for every account.
# TRANSCRIBE_VIDEO=0
# Work limits: recordings in flight per account / across the process, media size,
# download and ffmpeg time limits.
# PER_ACCOUNT_CONCURRENCY=2
# GLOBAL_CONCURRENCY=8
# MAX_MEDIA_BYTES=67108864
# MEDIA_DOWNLOAD_TIMEOUT_MS=90000
# FFMPEG_TIMEOUT_MS=120000

# --- WhatsApp link ---
# Asking the phone for an app-state resync (archived chats) makes it show
# "WhatsApp synced with a linked device" and clears notifications: at most once
# per this many days (0 = never).
# APP_STATE_RESYNC_DAYS=7

# --- rarely needed ---
# FFMPEG_PATH=                # a verified ffmpeg binary, instead of the one ffmpeg-static downloads
# WA_LOG=silent               # Baileys' own log level (pino). Anything but silent may log message content
# TRANSCRIBE_TIMEOUT_MS=60000
# MAX_QUEUE_PER_ACCOUNT=20    # recordings waiting per account, beyond the running ones
# UNLINKED_TTL_MINUTES=30     # an account that never finished linking is removed after this long
# INVITE_BONUS_MINUTES=10     # extra minutes a day for each friend who linked through an account's invite link...
# INVITE_BONUS_MAX=60         # ...up to this many bonus minutes a day (0 = unlimited)
# SELF_TRX_PREFIX=🎙️          # what the text under the owner's own voice notes starts with
# OWNER_NAME=                 # label of the 'default' account migrated from a single-user install

# Older names still read, so existing deployments keep working: GROQ_API_KEY / LLM_API_KEY
# (→ TRANSCRIBE_API_KEY), WHISPER_BASE_URL / WHISPER_MODEL / WHISPER_LANGUAGE (→ TRANSCRIBE_*),
# SHADOW_TRANSCRIBE_* (→ FREE_TRANSCRIBE_*), DASHBOARD_PASSWORD (→ ADMIN_PASSWORD).
