#!/bin/sh
# Refuses a commit that adds any line containing a term from .private-terms
# (gitignored; one term per line, case-insensitive, # for comments). Put there
# whatever must never reach the repository: names of real contacts, a work
# e-mail, an internal hostname. Enable once: git config core.hooksPath .githooks
# The brain (tomer-van-cohen/ramble-brain) is its own repository, checked out at ./brain:
# nothing under it, and no file carrying its RAMBLE-PRIVATE marker, is ever committed here.
if git diff --cached --name-only | grep -qE '^brain/'; then
  echo "✋ brain/ is the private brain's own checkout — commit it there, never here" >&2; exit 1
fi
if git diff --cached -U0 --no-color -- src test scripts | grep -E '^\+' | grep -vE '^\+\+\+ ' | grep -q 'RAMBLE-PRIVATE'; then
  echo "✋ a staged line carries the RAMBLE-PRIVATE marker: that code belongs in the brain repository" >&2; exit 1
fi
terms="$(git rev-parse --show-toplevel)/.private-terms"
[ -f "$terms" ] || exit 0
pat="$(grep -vE '^[[:space:]]*(#|$)' "$terms")"
[ -n "$pat" ] || exit 0
if git var GIT_AUTHOR_IDENT | grep -iFq -e "$pat"; then
  echo "✋ the author identity matches .private-terms — fix user.name / user.email for this repository" >&2; exit 1
fi
hits="$(git diff --cached -U0 --no-color | grep -E '^\+' | grep -vE '^\+\+\+ ' | grep -iF -e "$pat")"
if [ -n "$hits" ]; then
  echo "✋ staged lines contain a term from .private-terms (use synthetic data instead):" >&2
  echo "$hits" | cut -c1-160 >&2; exit 1
fi
